; Vértices de las escenas BSC1: posición y UV llegan como enteros de 16 bits (como en el .hgr)
; y aquí se escalan: pos = v * scale + bias, uv = (u, v) * (s, -s) + (0, 1)
; (el .hgr usa UV con origen arriba; citro3d, abajo).

.fvec projection[4]
.fvec modelView[4]
.fvec posScale    ; (s, s, s, 0)
.fvec posBias     ; (bx, by, bz, 1)
.fvec uvScale     ; (s, -s, 0, 0)
.fvec uvBias      ; (0, 1, 0, 0)
.fvec color       ; color del material (RGBA 0..1)

.out outpos position
.out outtc0 texcoord0
.out outclr color

.alias inpos v0
.alias intex v1

.proc main
	mul r0, posScale, inpos
	add r0, posBias, r0

	dp4 r1.x, modelView[0], r0
	dp4 r1.y, modelView[1], r0
	dp4 r1.z, modelView[2], r0
	dp4 r1.w, modelView[3], r0

	dp4 outpos.x, projection[0], r1
	dp4 outpos.y, projection[1], r1
	dp4 outpos.z, projection[2], r1
	dp4 outpos.w, projection[3], r1

	mul r2, uvScale, intex
	add outtc0, uvBias, r2

	mov outclr, color
	end
.end
